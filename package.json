{
    "name": "integration-test",
    "version": "0.2.0",
    "author": "shiy2008@gmail.com",
    "packageManager": "pnpm@12.21.0",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "private": true,
    "devDependencies": {
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.21",
        "@types/node": "26.6.6",
        "expect": "30.5.2",
        "husky": "^8.0.2",
        "jest-mock": "30.5.2",
        "lint-staged": "^13.1.0",
        "playwright": "^1.29.0",
        "prettier": "^2.8.1",
        "typescript": "6.0.3"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "all",
        "arrowParens": "avoid",
        "tabWidth": 4
    },
    "lint-staged": {
        "*.{md,json,yml,ts}": "prettier --write"
    },
    "scripts": {
        "prepare": "husky install",
        "lint": "lint-staged",
        "test-server": "node --import @swc-node/register/esm-register --test test/server/*.spec.ts",
        "test-browser": "node --import @swc-node/register/esm-register --test test/browser/*.spec.ts",
        "test": "pnpm lint && pnpm test-server && pnpm test-browser"
    },
    "dependencies": {
        "zx": "8.8.5"
    }
}
