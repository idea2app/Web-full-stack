{
    "name": "integration-test",
    "version": "0.2.0",
    "author": "shiy2008@gmail.com",
    "private": true,
    "packageManager": "pnpm@12.21.0",
    "type": "module",
    "engines": {
        "node": ">=26",
        "pnpm": ">=12"
    },
    "dependencies": {
        "array-unique-proposal": "^0.3.4",
        "yaml": "^2.9.1",
        "zx": "^8.8.5"
    },
    "devDependencies": {
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.22",
        "@types/node": "^26.6.6",
        "expect": "^30.5.2",
        "husky": "^9.1.7",
        "jest-mock": "^30.5.2",
        "lint-staged": "^17.6.1",
        "playwright": "^1.65.1",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "vercel": "66.6.0"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "all",
        "arrowParens": "avoid",
        "tabWidth": 4
    },
    "lint-staged": {
        "*.{md,json,yml,ts}": "prettier --write"
    },
    "scripts": {
        "prepare": "husky",
        "pretest": "playwright install chromium",
        "lint": "lint-staged",
        "test-server": "node --import @swc-node/register/esm-register --test test/server/*.spec.ts",
        "test-browser": "node --import @swc-node/register/esm-register --test test/browser/*.spec.ts",
        "test": "pnpm lint && pnpm test-server && pnpm test-browser"
    }
}
