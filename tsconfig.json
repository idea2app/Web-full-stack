{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "rewriteRelativeImportExtensions": true,
        "allowImportingTsExtensions": true,
        "strict": true,
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["script/**/*.ts", "test/**/*.ts"]
}
